{
  "name": "web-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A chat agent with web search, temporal memory and an evidence ledger.",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch src/server/index.ts\" \"vite --config web/vite.config.ts\"",
    "start": "tsx src/server/index.ts",
    "ask": "tsx scripts/ask.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "demo": "tsx scripts/demo.ts",
    "diagrams": "node docs/diagrams/build.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@hono/node-server": "^2.1.7",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.10",
    "hono": "^4.13.18",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@radix-ui/react-hover-card": "^1.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.5",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
