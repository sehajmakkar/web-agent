# LLM provider. Only "gemini" is implemented today (availability constraint C-0, see docs/DECISIONS.md).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Chosen in Phase 0 / ADR-017 (free-tier keys → Flash-Lite for both roles). Override if needed.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EXTRACT_MODEL=gemini-3.5-flash-lite
# Tried in order when the model is overloaded (503) or times out. Quota errors (429) are NOT retried on
# another model; they surface as a clear "quota exceeded, rotate GEMINI_API_KEY" error.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
# minimal | low | medium | high
GEMINI_THINKING_LEVEL=low

# Web search: Exa is primary, Tavily is the fallback (at least one key required)
EXA_API_KEY=
TAVILY_API_KEY=

# Background evidence extraction after each answer (+1 cheap model call per answer). Set false to save quota.
EXTRACT_ENABLED=true

# Optional
# AGENT_NOW=2026-11-11T10:00:00   # freeze the clock (evals and demos)
# AGENT_TZ=Europe/London          # fallback timezone if the browser doesn't send one
# DB_PATH=data/agent.db
# PORT=8787                       # API port (dev)
# WEB_PORT=5173                   # UI port (dev)
